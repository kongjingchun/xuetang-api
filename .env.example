# xuetang-api 环境变量示例。复制为 .env 后按需修改。
# 仓库不提交 .env。docker compose 已内置一套开发默认值，不复制本文件也可以启动。

# 应用名称，出现在日志和健康检查中
APP_NAME=xuetang-api
# 运行环境：dev / test / prod
APP_ENV=dev
# 应用级密钥，后续签名内部数据时使用。生产环境必须更换
APP_SECRET_KEY=dev-only-change-me
# HTTP API 前缀
API_PREFIX=/api/v1

# MySQL 8.0。compose 网络内主机名是 mysql，本机直连改为 127.0.0.1
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=xuetang
MYSQL_PASSWORD=xuetang_pass
MYSQL_DATABASE=xuetang_api

# Redis 7.0。0 缓存与锁，1 Celery broker，2 结果，3 任务状态
REDIS_HOST=redis
REDIS_PORT=6379
# 空表示不鉴权。生产环境应设置密码
REDIS_PASSWORD=

# 首次种子写入的管理员。已存在时不会覆盖密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

# 阶段 1 登录令牌使用。生产环境必须更换
JWT_SECRET=dev-only-change-me-jwt
# 访问令牌有效分钟数
JWT_EXPIRE_MINUTES=120

# 变量和数据源密码使用的 Fernet 密钥。为空时拒绝保存敏感字段。
# 下面是仅供开发的示例密钥，生产环境必须重新生成。
# 生成：python3.12 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# 上传、录制和报告文件目录。compose 挂载到命名卷
DATA_DIR=/data

# 宿主机映射端口
BACKEND_PORT=8000
MOCK_PORT=8001
FRONTEND_PORT=8080
MYSQL_PUBLISH_PORT=3306
REDIS_PUBLISH_PORT=6379
